# Read by uvicorn only when explicitly loaded; never put this key in VITE_*.
MESHY_API_KEY=
PIPELINE_PROVIDER=meshy
# Explicit fixture mode makes a synthetic box and image, NOT AI reconstruction.
# PIPELINE_PROVIDER=fixture
MESHY_IMAGE_MODEL=nano-banana
MESHY_3D_MODEL=meshy-6
PIPELINE_POLL_SECONDS=3
PIPELINE_MAX_SUBMISSIONS=12
PIPELINE_COMPAT_TIMEOUT=120
# Default data directory: server/.data; use one backend process/worker.
# PIPELINE_DATA_DIR=/absolute/path/to/persistent/data
PIPELINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
